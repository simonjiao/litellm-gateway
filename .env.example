# Open WebUI Backend/BFF -> LiteLLM deployment credential.
LITELLM_MASTER_KEY=replace-with-a-long-random-gateway-key
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# LiteLLM and Open WebUI BFF -> Responses Adapter credential.
CODEX_ADAPTER_BASE_URL=http://127.0.0.1:8090/v1
CODEX_ADAPTER_API_KEY=replace-with-a-long-random-adapter-key
CODEX_ADAPTER_HOST=127.0.0.1
CODEX_ADAPTER_PORT=8090
CODEX_ADAPTER_AGENT_HOST_BASE_URL=http://127.0.0.1:8092
CODEX_ADAPTER_AGENT_HOST_API_KEY=replace-with-a-long-random-host-key
CODEX_ADAPTER_AGENT_WORKSPACE=/workspace
CODEX_ADAPTER_CODEX_MODEL=
CODEX_ADAPTER_CODEX_EPHEMERAL_THREADS=false
CODEX_ADAPTER_REQUEST_TIMEOUT_SECONDS=3600
CODEX_ADAPTER_MAX_CONCURRENT_EXECUTIONS=8

# MCP Apps. This should be an Open WebUI BFF same-origin proxy prefix that
# forwards /v1/mcp-apps/* to the Adapter with CODEX_ADAPTER_API_KEY.
CODEX_ADAPTER_MCP_APPS_ENABLED=true
CODEX_ADAPTER_MCP_APPS_PUBLIC_BASE_URL=http://127.0.0.1:3000/api/codex-adapter
CODEX_ADAPTER_MCP_APPS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CODEX_ADAPTER_MCP_APPS_INTERACTION_TIMEOUT_SECONDS=3600
CODEX_ADAPTER_MCP_APPS_EVENT_KEEPALIVE_SECONDS=15
CODEX_ADAPTER_MCP_APPS_MAX_EVENT_HISTORY=512
CODEX_ADAPTER_MCP_APPS_RESOURCE_MAX_BYTES=4194304

# Responses Adapter -> Sandbox Agent Host credential.
SANDBOX_HOST_HOST=127.0.0.1
SANDBOX_HOST_PORT=8092
SANDBOX_HOST_API_KEY=replace-with-a-long-random-host-key
SANDBOX_HOST_WORKER_API_KEY=replace-with-a-long-random-worker-key
SANDBOX_HOST_IMAGE=litellm-codex-sandbox-worker:0.3.0
SANDBOX_HOST_DOCKER_RUNTIME=runsc
SANDBOX_HOST_DOCKER_NETWORK=codex-agent-egress
SANDBOX_HOST_EGRESS_PROXY_URL=http://egress-proxy:3128
SANDBOX_HOST_EXECUTION_TTL_SECONDS=1800
SANDBOX_HOST_REAPER_INTERVAL_SECONDS=15
SANDBOX_HOST_MEMORY_LIMIT=4g
SANDBOX_HOST_NANO_CPUS=2000000000
SANDBOX_HOST_PIDS_LIMIT=512
SANDBOX_HOST_CODEX_COMMAND=codex app-server --stdio
SANDBOX_HOST_CODEX_MODEL=

# Deployment-owned Codex/MCP configuration; mounted read-only inside each Sandbox.
SANDBOX_HOST_CODEX_AUTH_FILE=
SANDBOX_HOST_CODEX_CONFIG_FILE=

# Optional token used by the local MCP Apps smoke script when it targets a BFF.
MCP_APPS_BFF_TOKEN=
