# Public Gateway credential and host-side smoke endpoint.
LITELLM_MASTER_KEY=replace-with-a-long-random-gateway-key
LITELLM_PORT=4000
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# Gateway/BFF -> Responses Adapter credential.
CODEX_ADAPTER_API_KEY=replace-with-a-long-random-adapter-key
CODEX_ADAPTER_AGENT_WORKSPACE=/workspace
CODEX_ADAPTER_CODEX_MODEL=
CODEX_ADAPTER_CODEX_EPHEMERAL_THREADS=false
CODEX_ADAPTER_REQUEST_TIMEOUT_SECONDS=3600
CODEX_ADAPTER_MAX_CONCURRENT_EXECUTIONS=8
CODEX_ADAPTER_SANDBOX_LEASE_RENEW_INTERVAL_SECONDS=30

# MCP Apps. The public base URL is the BFF same-origin proxy prefix.
CODEX_ADAPTER_MCP_APPS_ENABLED=true
CODEX_ADAPTER_MCP_APPS_PUBLIC_BASE_URL=http://127.0.0.1:3000/api/codex-adapter
CODEX_ADAPTER_MCP_APPS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CODEX_ADAPTER_MCP_APPS_INTERACTION_TIMEOUT_SECONDS=3600
CODEX_ADAPTER_MCP_APPS_EVENT_KEEPALIVE_SECONDS=15
CODEX_ADAPTER_MCP_APPS_MAX_EVENT_HISTORY=512
CODEX_ADAPTER_MCP_APPS_RESOURCE_MAX_BYTES=4194304

# Responses Adapter -> Sandbox Manager credential and Manager runtime settings.
SANDBOX_MANAGER_API_KEY=replace-with-a-long-random-manager-key
SANDBOX_MANAGER_WORKER_TOKEN_SECRET=replace-with-at-least-32-random-characters
SANDBOX_MANAGER_IMAGE=litellm-codex-sandbox-worker:0.3.0
SANDBOX_MANAGER_DOCKER_RUNTIME=runsc
SANDBOX_MANAGER_RPC_NETWORK=agent-rpc
SANDBOX_MANAGER_EGRESS_NETWORK=agent-egress
SANDBOX_MANAGER_EGRESS_PROXY_URL=http://egress-proxy:3128
SANDBOX_MANAGER_WORKER_PORT=8091
SANDBOX_MANAGER_EXECUTION_TTL_SECONDS=1800
SANDBOX_MANAGER_REAPER_INTERVAL_SECONDS=15
SANDBOX_MANAGER_MEMORY_LIMIT=4g
SANDBOX_MANAGER_NANO_CPUS=2000000000
SANDBOX_MANAGER_PIDS_LIMIT=512
SANDBOX_MANAGER_TMPFS_LIMIT=256m
SANDBOX_MANAGER_CODEX_COMMAND="codex app-server --stdio"
SANDBOX_MANAGER_CODEX_MODEL=

# run-stack.sh copies the default Codex authentication into the ignored runtime
# directory. Override the source only when CODEX_HOME is not $HOME/.codex.
SANDBOX_MANAGER_CODEX_AUTH_SOURCE_FILE=
SANDBOX_MANAGER_CODEX_CONFIG_SOURCE_FILE=
SANDBOX_MANAGER_SECRET_DIR=

# Optional Agent-accessible internal services. Each entry is
# dns-name=container-name:tcp-port. Attach those containers to agent-egress first;
# run-stack.sh derives the matching DNS and NO_PROXY policy.
SANDBOX_AGENT_INTERNAL_SERVICES=

# Ordinary control-plane network.
CONTROL_NETWORK=responses-control
CONTROL_PLANE_IMAGE=litellm-responses-control:0.3.0

# Policy egress proxy. Port 3128 is never host-published.
SANDBOX_EGRESS_PROXY_IMAGE=litellm-codex-egress-proxy:0.1.0
SANDBOX_EGRESS_PROXY_CONTAINER=egress-proxy
SANDBOX_EGRESS_PROXY_ALIAS=egress-proxy
SANDBOX_EGRESS_UPLINK_NETWORK=agent-egress-uplink
SANDBOX_EGRESS_ALLOWED_DOMAINS_FILE=deploy/egress-proxy/allowed-domains.txt
SANDBOX_EGRESS_UPSTREAM_PROXY_URL=
SANDBOX_EGRESS_UPSTREAM_RELAY_CONTAINER=egress-upstream-relay
SANDBOX_EGRESS_UPSTREAM_RELAY_PORT=17890
SANDBOX_EGRESS_PROXY_MEMORY_LIMIT=256m
SANDBOX_EGRESS_PROXY_CPUS=0.50
SANDBOX_EGRESS_PROXY_PIDS_LIMIT=128

# Authoritative DNS for policy and approved internal Agent endpoints.
SANDBOX_AGENT_DNS_IMAGE=litellm-agent-dns:0.1.0
SANDBOX_AGENT_DNS_CONTAINER=agent-dns
SANDBOX_AGENT_DNS_MEMORY_LIMIT=64m
SANDBOX_AGENT_DNS_CPUS=0.25
SANDBOX_AGENT_DNS_PIDS_LIMIT=32

# Optional token for a BFF-targeted MCP Apps smoke.
MCP_APPS_BFF_TOKEN=
